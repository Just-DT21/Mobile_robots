<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="mobile_robot_lab_world">

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -1.0</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </visual>
      </link>
    </model>

    <model name="box">
      <static>true</static>
      <pose>-3 2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 1 1</size></box></geometry></visual>
      </link>
    </model>

    <model name="sphere">
      <static>true</static>
      <pose>0 2 0.7 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.7</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.7</radius></sphere></geometry></visual>
      </link>
    </model>

    <model name="cylinder">
      <static>true</static>
      <pose>3 2 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.6</radius><length>1.5</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.6</radius><length>1.5</length></cylinder></geometry></visual>
      </link>
    </model>

    <model name="capsule">
      <static>true</static>
      <pose>-1.8 -2 0.7 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><capsule><radius>0.5</radius><length>1.0</length></capsule></geometry></collision>
        <visual name="visual"><geometry><capsule><radius>0.5</radius><length>1.0</length></capsule></geometry></visual>
      </link>
    </model>

    <model name="ellipsoid">
      <static>true</static>
      <pose>1.5 -2 0.7 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><ellipsoid><radii>0.8 0.5 0.7</radii></ellipsoid></geometry></collision>
        <visual name="visual"><geometry><ellipsoid><radii>0.8 0.5 0.7</radii></ellipsoid></geometry></visual>
      </link>
    </model>

  </world>
</sdf>
